# --- AI scoring. AI_PROVIDER = omniroute | anthropic (empty = auto: omniroute if its URL is set). No AI = keyword-only scoring.
AI_PROVIDER=omniroute

# OmniRoute (or any OpenAI-compatible router). /v1 is added if missing.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
# Model name exactly as OmniRoute lists it (dashboard / GET /v1/models), e.g. a provider-prefixed id
OMNIROUTE_MODEL=

# Anthropic direct (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional proxy for Telegram (needed if the server is in Iran), e.g. http://127.0.0.1:10809
TELEGRAM_PROXY=
# Send a digest of rejected/errored applicants after each run (true/false)
TELEGRAM_DIGEST=true

# --- Job sites: paste the auth values you copied from DevTools (Network > request headers)
JOBINJA_COOKIE=
JOBINJA_TOKEN=
# Jobvision: DevTools > Network > any employerapi.jobvision.ir request > Authorization header (with or without 'Bearer ')
JOBVISION_TOKEN=
# Or let the app log in by itself (set from the dashboard settings page)
JOBVISION_EMAIL=
JOBVISION_PASSWORD=
# Optional proxy for the job sites
SOURCE_PROXY=

# --- Scheduler (cron syntax). Default: every 20 minutes
SCHEDULE_CRON=*/20 * * * *

# --- Paths
DB_PATH=data/ats.db
SOURCES_FILE=sources.yaml
CRITERIA_DIR=criteria
