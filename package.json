{
    "name": "ats-automation",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Custom ATS: pull applicants from Jobinja/Jobvision, score them against your criteria, forward accepted ones to Telegram.",
    "engines": {
        "node": ">=22.13"
    },
    "scripts": {
        "ats": "tsx core/cli.ts",
        "run": "tsx core/cli.ts run",
        "dry": "tsx core/cli.ts run --dry-run",
        "probe": "tsx core/cli.ts probe",
        "schedule": "tsx core/cli.ts schedule",
        "build": "next build",
        "typecheck": "tsc --noEmit",
        "check": "npm run typecheck && npm test",
        "test": "tsx --test test/*.test.ts",
        "dashboard": "next dev",
        "dev": "next dev",
        "start": "next start",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^1.8.0",
        "@radix-ui/react-slot": "^1.5.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dotenv": "^18.0.10",
        "fflate": "^0.8.3",
        "lucide-react": "^1.83.0",
        "mammoth": "^1.13.0",
        "next": "^16.4.6",
        "node-cron": "^4.6.0",
        "pdf-parse": "^2.4.5",
        "playwright-core": "^1.65.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "swr": "^2.5.1",
        "tailwind-merge": "^3.7.1",
        "undici": "^8.12.4",
        "yaml": "^2.9.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.5",
        "@types/node": "^26.6.6",
        "@types/node-cron": "^3.0.11",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "postcss": "^8.5.34",
        "prettier": "^3.10.1",
        "tailwindcss": "^4.3.5",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
