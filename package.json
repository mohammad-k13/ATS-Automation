{
  "name": "ats-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Custom ATS: pull applicants from Jobinja/Jobvision, score them against your criteria, forward accepted ones to Telegram.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "ats": "tsx src/cli.ts",
    "run": "tsx src/cli.ts run",
    "dry": "tsx src/cli.ts run --dry-run",
    "probe": "tsx src/cli.ts probe",
    "schedule": "tsx src/cli.ts schedule",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dashboard": "tsx src/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "dotenv": "^18.0.10",
    "mammoth": "^1.13.0",
    "node-cron": "^4.6.0",
    "pdf-parse": "^2.4.5",
    "undici": "^8.12.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
